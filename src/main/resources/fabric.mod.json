{
  "schemaVersion": 1,
  "id": "mplay",
  "version": "${version}",
  "name": "MPlay",
  "description": "Play music in Minecraft using Simple Voice Chat.",
  "authors": [
    "Kenzx"
  ],
  "contact": {
    "homepage": "https://github.com/luoshenshi/mplay",
    "sources": "https://github.com/luoshenshi/mplay",
    "issues": "https://github.com/luoshenshi/mplay/issues"
  },
  "license": "MIT",
  "icon": "assets/mplay/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.kenzx.mplay.MPlayServer"
    ],
    "client": [
      "com.kenzx.mplay.MPlayClient"
    ],
    "voicechat": [
      "com.kenzx.mplay.SVC"
    ]
  },
  "mixins": [],
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "~26.2",
    "java": ">=25",
    "fabric-api": "*",
    "voicechat": ">=2.6.17+26.1.2"
  }
}
